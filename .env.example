# CloudForge AI Environment Variables
# Copy this file to .env and fill in the values

# ========================================
# AWS Configuration
# ========================================
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-account-id

# ========================================
# Frontend Configuration
# ========================================
VITE_API_BASE_URL=http://localhost:3000
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=your-user-pool-id
VITE_COGNITO_CLIENT_ID=your-client-id

# ========================================
# Backend Configuration
# ========================================

# DynamoDB Tables
DYNAMODB_USERS_TABLE=cloudforge-users
DYNAMODB_DIAGRAMS_TABLE=cloudforge-diagrams
DYNAMODB_DEPLOYMENTS_TABLE=cloudforge-deployments

# S3 Buckets
S3_DIAGRAMS_BUCKET=cloudforge-diagrams-your-account-id
S3_TEMPLATES_BUCKET=cloudforge-templates-your-account-id

# Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v2:0
BEDROCK_REGION=us-east-1

# API Configuration
API_GATEWAY_URL=your-api-gateway-url

# Logging
LOG_LEVEL=INFO

# ========================================
# Development Configuration
# ========================================

# CDK Configuration
CDK_DEFAULT_ACCOUNT=your-account-id
CDK_DEFAULT_REGION=us-east-1

# Local Development
NODE_ENV=development
