# Backend Environment Variables
# These will be set by CDK during deployment
# This file is for local development reference only

# AWS Configuration
AWS_REGION=us-east-1

# DynamoDB Tables
DYNAMODB_USERS_TABLE=cloudforge-users
DYNAMODB_DIAGRAMS_TABLE=cloudforge-diagrams
DYNAMODB_DEPLOYMENTS_TABLE=cloudforge-deployments

# S3 Buckets
S3_DIAGRAMS_BUCKET=cloudforge-diagrams-your-account-id
S3_TEMPLATES_BUCKET=cloudforge-templates-your-account-id

# Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v2:0
BEDROCK_REGION=us-east-1

# Logging
LOG_LEVEL=INFO

# Cognito (set by CDK)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
