{
  "name": "cloudforge-ai-backend",
  "version": "0.1.0",
  "description": "CloudForge AI Backend Infrastructure with AWS CDK",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:layer": "bash scripts/build-layer.sh",
    "watch": "tsc -w",
    "cdk": "cdk",
    "cdk:deploy": "cdk deploy --all",
    "cdk:destroy": "cdk destroy --all",
    "cdk:synth": "cdk synth",
    "cdk:diff": "cdk diff",
    "cdk:bootstrap": "cdk bootstrap",
    "lint": "eslint src lib bin --ext .ts",
    "lint:fix": "eslint src lib bin --ext .ts --fix",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "aws",
    "cdk",
    "cloudforge",
    "infrastructure"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "aws-cdk-lib": "^2.262.0",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "^10.7.1",
    "eslint": "^9.39.5",
    "fast-check": "^4.9.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1094.0",
    "@aws-sdk/client-cloudformation": "^3.1094.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1094.0",
    "@aws-sdk/client-dynamodb": "^3.1094.0",
    "@aws-sdk/client-pricing": "^3.1094.0",
    "@aws-sdk/client-s3": "^3.1094.0",
    "@aws-sdk/client-secrets-manager": "^3.1094.0",
    "@aws-sdk/client-sfn": "^3.1095.0",
    "@aws-sdk/client-sts": "^3.1094.0",
    "@aws-sdk/lib-dynamodb": "^3.1094.0",
    "yaml": "^2.9.0"
  }
}
