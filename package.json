{
  "name": "cloudforge-ai",
  "version": "0.1.0",
  "private": true,
  "description": "CloudForge AI - AWS Infrastructure Design and Deployment Platform",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run watch",
    "build": "npm-run-all build:frontend build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "lint": "npm-run-all lint:frontend lint:backend",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "cd backend && npm run lint",
    "lint:fix": "npm-run-all lint:fix:frontend lint:fix:backend",
    "lint:fix:frontend": "cd frontend && npm run lint:fix",
    "lint:fix:backend": "cd backend && npm run lint:fix",
    "format": "npm-run-all format:frontend format:backend",
    "format:frontend": "cd frontend && npm run format",
    "format:backend": "cd backend && npm run format",
    "test": "npm-run-all test:frontend test:backend",
    "test:frontend": "cd frontend && npm test -- --run",
    "test:backend": "cd backend && npm test",
    "type-check": "npm-run-all type-check:frontend type-check:backend",
    "type-check:frontend": "cd frontend && npm run type-check",
    "type-check:backend": "cd backend && npm run build",
    "clean": "npm-run-all clean:frontend clean:backend",
    "clean:frontend": "cd frontend && rm -rf dist node_modules",
    "clean:backend": "cd backend && rm -rf lib cdk.out node_modules",
    "setup": "npm-run-all setup:frontend setup:backend",
    "setup:frontend": "cd frontend && npm install",
    "setup:backend": "cd backend && npm install",
    "cdk:deploy": "cd backend && npm run cdk:deploy",
    "cdk:synth": "cd backend && npm run cdk:synth",
    "cdk:diff": "cd backend && npm run cdk:diff"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
